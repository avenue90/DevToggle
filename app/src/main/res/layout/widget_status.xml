<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:gravity="center" android:padding="8dp" android:background="@drawable/widget_background">
    <ImageView android:id="@+id/light" android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/light_off" android:importantForAccessibility="no" />
    <TextView android:id="@+id/label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp"
        android:text="Debug off" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" />
    <TextView android:id="@+id/mode" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Wireless" android:textColor="#BBBBBB" android:textSize="11sp" />
</LinearLayout>
