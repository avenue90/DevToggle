<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Granted once from a computer: adb shell pm grant com.ketan.devtoggle android.permission.WRITE_SECURE_SETTINGS -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <application android:label="Debug toggle" android:icon="@drawable/ic_debug" android:allowBackup="false">
        <!-- Launcher icon: one tap toggles, shows a toast, closes. -->
        <activity android:name=".ToggleActivity" android:exported="true" android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true" android:noHistory="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Quick Settings tile showing the current state. -->
        <service android:name=".DebugTile" android:exported="true" android:label="Wireless debug" android:icon="@drawable/ic_debug"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
    </application>
</manifest>
